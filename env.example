# Copy this file to .env in the project root and fill in your values.
# SMTP for contact form (used by server only – do not use in frontend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER=your-email@gmail.com

# Optional: port for contact API server (default 3001)
# PORT=3001
